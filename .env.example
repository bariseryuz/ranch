## LLM (Gemini)
# Required
GEMINI_API_KEY=

# Optional
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

## Vector DB (Pinecone)
# Required
PINECONE_API_KEY=
PINECONE_INDEX=briggs

# Optional
PINECONE_NAMESPACE=default

## RAG content
# Optional (defaults to server/rag/knowledge)
RAG_KNOWLEDGE_PATH=server/rag/knowledge

# Inquiry form → CRM / Zapier / Make (optional)
# VITE_INQUIRY_WEBHOOK=https://...

# --- Browser (Vite; only VITE_* is public) ---
# Same origin in production (Railway): use relative path. Local dev: run `npm run dev:api` + Vite proxy.
# VITE_CONCIERGE_API_URL=/api/concierge

# --- Server only (never prefix with VITE_; never exposed to the browser) ---
# Google AI Studio / Gemini API key — set on Railway as GEMINI_API_KEY, or below for local `npm run dev:api`
# GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
