## LLM (Gemini)
# Required
GEMINI_API_KEY=

# Optional
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

## Vector DB (Pinecone)
# Required
PINECONE_API_KEY=
PINECONE_INDEX=briggs

# Optional
PINECONE_NAMESPACE=default

# Optional: query multiple Pinecone namespaces at once (comma-separated), e.g. if menu was ingested with --namespace menu
# RAG_RETRIEVAL_NAMESPACES=default,menu

## Email (inquiry form → inbox)
# Required to enable email delivery; leave blank for demo/log-only mode
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
INQUIRY_TO=info@briggsbrothersranch.com

## RAG content
# Optional (defaults to server/rag/knowledge)
RAG_KNOWLEDGE_PATH=server/rag/knowledge

# Inquiry form → CRM / Zapier / Make (optional)
# VITE_INQUIRY_WEBHOOK=https://...

## Little Hotelier — SiteMinder IBE embed
# Find both values in Little Hotelier under the Website Integration / Widget setup screen
# data-channelcode from the <div class="ibe" ...> snippet
VITE_LH_CHANNEL_CODE=
# data-region from the same snippet (e.g. emea, apac)
VITE_LH_REGION=emea

# --- Browser (Vite; only VITE_* is public) ---
# Same origin in production (Railway): use relative path. Local dev: run `npm run dev:api` + Vite proxy.
# VITE_CONCIERGE_API_URL=/api/concierge

# --- Server only (never prefix with VITE_; never exposed to the browser) ---
# Google AI Studio / Gemini API key — set on Railway as GEMINI_API_KEY, or below for local `npm run dev:api`
# GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
